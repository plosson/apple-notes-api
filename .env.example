# Required in production. Generate with: openssl rand -hex 32
NOTES_API_KEY=change-me-to-a-long-random-secret

# Bind address (default 127.0.0.1 — keep localhost unless you know what you are doing)
NOTES_API_HOST=127.0.0.1
NOTES_API_PORT=8787

# Set to 1 ONLY for local development without a key (refused otherwise)
# NOTES_API_ALLOW_INSECURE=1

# Optional: osascript timeout in ms (default 30000)
# NOTES_API_OSASCRIPT_TIMEOUT_MS=30000

# Optional: Notes' database, read for checklist state (needs Full Disk Access)
# NOTES_API_NOTESTORE_PATH=/Users/<you>/Library/Group Containers/group.com.apple.notes/NoteStore.sqlite
