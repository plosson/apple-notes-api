<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Generated by scripts/install.sh — do not edit directly.
  Edit this .example file and re-run install.sh.
-->
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.plosson.apple-notes-api</string>
    <key>WorkingDirectory</key>
    <string>__REPO_DIR__</string>
    <key>ProgramArguments</key>
    <array>
      <string>__NODE_BIN__</string>
      <string>__REPO_DIR__/node_modules/tsx/dist/cli.mjs</string>
      <string>__REPO_DIR__/src/index.ts</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
      <key>NOTES_API_KEY</key>
      <string>__NOTES_API_KEY__</string>
      <key>NOTES_API_HOST</key>
      <string>127.0.0.1</string>
      <key>NOTES_API_PORT</key>
      <string>__NOTES_API_PORT__</string>
      <key>PATH</key>
      <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/__USER__/Library/Logs/apple-notes-api.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/__USER__/Library/Logs/apple-notes-api.err.log</string>
  </dict>
</plist>
